FROM golang:1.27.1@sha256:<verified-builder-digest> AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 \
    GOOS=linux \
    GOARCH=amd64 \
    go build -trimpath -o /out/app

FROM gcr.io/distroless/static-debian12:nonroot@sha256:<verified-runtime-digest>

COPY --from=builder --chown=nonroot:nonroot /out/app /app

USER nonroot:nonroot

ENTRYPOINT ["/app"]
